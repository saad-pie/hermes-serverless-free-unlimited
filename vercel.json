{
  "version": 2,
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/v1/chat/completions",
      "dest": "/api/chat"
    },
    {
      "src": "/api/chat",
      "dest": "/api/chat"
    },
    {
      "src": "/v1/models",
      "dest": "/api/models"
    },
    {
      "src": "/api/models",
      "dest": "/api/models"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
